# syntax=docker/dockerfile:1.7

FROM node:22.17.0-bookworm-slim AS web-builder

WORKDIR /workspace
ENV COREPACK_HOME=/tmp/corepack

RUN corepack enable \
    && corepack prepare pnpm@10.17.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/agent-runtime/package.json packages/agent-runtime/package.json
COPY packages/browser-runner/package.json packages/browser-runner/package.json

RUN pnpm install --frozen-lockfile --filter @memeloop-geo/web

COPY apps/web apps/web
RUN pnpm --filter @memeloop-geo/web build

# The unprivileged variant defaults to a non-root worker and port 8080.
FROM nginxinc/nginx-unprivileged:1.28.0-alpine AS web

COPY deploy/demo/nginx.conf /etc/nginx/nginx.conf
COPY --from=web-builder /workspace/apps/web/dist /usr/share/nginx/html
COPY LICENSE /usr/share/nginx/html/LICENSE

EXPOSE 8080
