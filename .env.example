# Docker Compose project name. All values below are development-only defaults.
COMPOSE_PROJECT_NAME=memeloop-geo

# PostgreSQL
POSTGRES_DB=memeloop
POSTGRES_USER=memeloop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://memeloop:change-me-local-only@localhost:5432/memeloop

# NATS JetStream
NATS_PORT=4222
NATS_MONITORING_PORT=8222
NATS_URL=nats://localhost:4222

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memeloop-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-local-only

# Browser-visible API endpoint. Never place service credentials in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080/api/v1
