# Docker Compose project name. All values below are development-only defaults.
COMPOSE_PROJECT_NAME=memeloop-geo

# PostgreSQL
POSTGRES_DB=memeloop
POSTGRES_USER=memeloop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://memeloop:change-me-local-only@localhost:5432/memeloop

# NATS JetStream
NATS_PORT=4222
NATS_MONITORING_PORT=8222
NATS_URL=nats://localhost:4222

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memeloop-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-local-only

# GEO API. Without DATABASE_URL the API only starts in explicit loopback
# development mode and requires a non-empty password.
GEO_BIND_ADDR=127.0.0.1:8080
GEO_DEV_PASSWORD=change-me-local-only
GEO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The browser stays same-origin; Vite proxies /api to the local API process.
# Never place service credentials in VITE_* variables.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional P00 local development only: set ALL five in the Rust process environment.
# Requires loopback binding and no DATABASE_URL. A durable/multi-tenant deployment
# needs a tenant-aware Token Center and provider route, not a process-wide key.
# Build the untracked ESM artifact with `pnpm agent:bundle`, compute its SHA-256
# locally, and supply its path/digest. Keep keys out of this file.
# GEO_AI_BASE_URL=<OpenAI-compatible API base URL ending in /v1>
# GEO_AI_API_KEY=<local development key from a secret source>
# GEO_AI_MODEL=<single allowed model routing ID>
# GEO_AGENT_BUNDLE_PATH=<absolute path to generated .mjs bundle>
# GEO_AGENT_BUNDLE_SHA256=<64-character SHA-256 of exact bundle bytes>

# Optional browser execution service (server-only; configure URL/token together).
# GEO_BROWSER_RUNNER_URL=<trusted internal browser runner origin>
# GEO_BROWSER_RUNNER_TOKEN=<shared service bearer secret>
# GEO_CHANNEL_SECRET_KEY=<64 hex characters from secret management; retain across restarts>
# GEO_OPERATOR_POOL_TENANT_ID=<resource administration tenant UUID>
# Missing persistent vault key disables credential operations, not unrelated app pages.
# GEO_BROWSER_CHANNEL=<optional chromium, chrome, or msedge; runner process only>

# Optional PostgreSQL tenant-routed P00 runtime. Set ALL five separately from
# the local development configuration above. Database grants are provisioned
# by the deployer; no inference request can select a key, subject, or gateway.
# GEO_PRODUCTION_AI_BASE_URL=<approved model gateway base URL>
# GEO_TOKEN_CENTER_URL=<trusted token service origin>
# GEO_TOKEN_CENTER_TOKEN=<internal service secret from secret management>
# GEO_PRODUCTION_AGENT_BUNDLE_PATH=<approved generated agent bundle path>
# GEO_PRODUCTION_AGENT_BUNDLE_SHA256=<SHA-256 of exact generated agent bundle>

# Optional native first-fanout workflow; requires either configured model mode.
# Both values are required. Build via pnpm agent:bundle, then hash exact bytes.
# GEO_CONTENT_BUNDLE_PATH=<path to memeloop-content-workflow.bundle.mjs>
# GEO_CONTENT_BUNDLE_SHA256=<SHA-256 of exact generated content workflow bundle>

# Optional isolated PDF text parser. No credentials or arbitrary source URLs
# are passed to this service. Start the opt-in document-parsing Compose profile.
# OCR, DOCX and XLSX remain unavailable; image-only PDF pages report missing OCR.
# GEO_PDF_PARSER_URL=http://127.0.0.1:18081
# GEO_PDF_PARSER_PORT=18081
