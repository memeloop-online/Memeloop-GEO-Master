# Start from a deny-all context. The Dockerfiles below only need the source
# manifests, frontend, bundle entrypoint, Rust crates, and SQL migrations.
**
!Dockerfile
!.dockerignore
!LICENSE
!Cargo.toml
!Cargo.lock
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!scripts/
scripts/*
!scripts/bundle-agent.mjs
!apps/
!apps/web/
!apps/web/**
!packages/
!packages/agent-runtime/
packages/agent-runtime/*
!packages/agent-runtime/package.json
!packages/agent-runtime/THIRD_PARTY_NOTICES.md
!packages/agent-runtime/src/
!packages/agent-runtime/src/**
!packages/browser-runner/
packages/browser-runner/*
!packages/browser-runner/package.json
!crates/
!crates/**
!migrations/
!migrations/**
!deploy/
!deploy/demo/
deploy/demo/*
!deploy/demo/Dockerfile.web
!deploy/demo/nginx.conf

# Local dependency trees, generated output, state, credentials, and captures
# must never enter an image context, even when a parent directory is allowed.
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/target
**/target/**
**/.cache
**/.cache/**
**/.vite
**/.vite/**
**/tmp
**/tmp/**
**/private
**/private/**
**/keys
**/keys/**
**/logs
**/logs/**
**/artifacts
**/artifacts/**
**/.artifacts
**/.artifacts/**
**/*.log
**/debug.log
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx
**/*.pem
**/*.key
**/*.p12
**/*.pfx
